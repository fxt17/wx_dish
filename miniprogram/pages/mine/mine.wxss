.mine-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f6f7f8;
}

/* ================================
   未登录页面
   ================================ */

.login-page {
  min-height: 100vh;

  display: flex;
  justify-content: center;   /* 垂直居中 */
  align-items: center;       /* 水平居中 */

  box-sizing: border-box;

  /* 给底部 tabBar 留空间 */
  padding: 40rpx 60rpx 160rpx;
}

.login-content {
  width: 100%;
  max-width: 620rpx;

  display: flex;
  flex-direction: column;
  align-items: center;

  text-align: center;
}

/* ---------- 标题 ---------- */
.login-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #222;
}

.login-desc {
  margin-top: 18rpx;

  font-size: 27rpx;
  color: #999;
}

/* ---------- 用户 ---------- */
.login-user {
  margin-top: 80rpx;

  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-wrapper {
  width: 156rpx;
  height: 156rpx;

  padding: 6rpx;

  box-sizing: border-box;

  background: #fff;

  border-radius: 50%;

  box-shadow:
    0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.login-avatar {
  width: 100%;
  height: 100%;

  border-radius: 50%;

  background: #eee;
}

.login-nickname {
  margin-top: 26rpx;

  font-size: 32rpx;
  font-weight: 600;

  color: #333;
}

.last-login-tip {
  margin-top: 8rpx;

  font-size: 24rpx;

  color: #aaa;
}

/* ---------- 登录按钮 ---------- */
.wechat-login-btn {
  width: 100%;
  height: 92rpx;

  margin-top: 64rpx;

  display: flex;
  justify-content: center;
  align-items: center;

  border-radius: 46rpx;

  background: #07c160;

  color: #fff;

  font-size: 30rpx;
  font-weight: 500;
}

.wechat-login-btn::after {
  border: none;
}

/* ---------- 其他账号 ---------- */
.other-login {
  margin-top: 34rpx;

  font-size: 27rpx;

  color: #576b95;
}

.other-login:active {
  opacity: 0.6;
}

/* ---------- 协议 ---------- */
.login-agreement {
  margin-top: 60rpx;

  font-size: 22rpx;

  color: #aaa;
}

.agreement-link {
  color: #666;
}

/* ---------- 用户信息 ---------- */
.user-header {
  display: flex;
  align-items: center;
  padding: 48rpx 24rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #eee;
}

.user-info {
  margin-left: 30rpx;
}

.nickname {
  font-size: 38rpx;
  font-weight: 600;
  color: #222;
}

.user-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

/* ---------- 功能菜单 ---------- */
.menu-card {
  margin-bottom: 24rpx;
  padding: 0 28rpx;
  background: #fff;
  border-radius: 24rpx;
}

.menu-item {
  min-height: 108rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f1f1f1;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 60rpx;
  font-size: 34rpx;
}

.menu-title {
  flex: 1;
  font-size: 29rpx;
  color: #333;
}

.menu-extra {
  margin-right: 14rpx;
  font-size: 25rpx;
  color: #aaa;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* ---------- 退出 ---------- */
.logout-btn {
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 22rpx;
  background: #fff;
  color: #e64340;
  font-size: 29rpx;
}

.logout-btn::after {
  border: none;
}