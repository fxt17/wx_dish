.dice-button {
  position: fixed;
  left: 0;
  top: 0;
  width: 110rpx;
  height: 150rpx;
  z-index: 10;
}

.dice-scene {
  position: relative;
  width: 110rpx;
  height: 110rpx;
}
.dice-lift, .dice-perspective {
  position: absolute;
  width: 100%;
  height: 100%;
}
.dice-lift { transition: transform 160ms ease; }
.dice-perspective {
  perspective: 500rpx;
  perspective-origin: 50% 42%;
}
.dice-cube {
  position: absolute;
  top: 17rpx;
  left: 19rpx;
  width: 72rpx;
  height: 72rpx;
  /* 不在立方体上设置 overflow/opacity/filter，避免六个面被压平。 */
  transform-style: preserve-3d;
  transform: rotateX(-24deg) rotateY(32deg) rotateZ(-6deg);
}
.dice-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  border: 1rpx solid #e7c6a0;
  border-radius: 6rpx;
  background: linear-gradient(145deg, #fffefb, #ffe6c5);
  box-shadow: inset 0 0 5rpx rgba(144, 81, 20, 0.13);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}
.dice-front { transform: translateZ(36rpx); }
.dice-back { transform: rotateY(180deg) translateZ(36rpx); }
.dice-right {
  transform: rotateY(90deg) translateZ(36rpx);
  background: linear-gradient(145deg, #ffe9cb, #efc995);
}
.dice-left {
  transform: rotateY(-90deg) translateZ(36rpx);
  background: linear-gradient(145deg, #fff2df, #f3d3a8);
}
.dice-top {
  transform: rotateX(90deg) translateZ(36rpx);
  background: linear-gradient(145deg, #fff, #fff2de);
}
.dice-bottom {
  transform: rotateX(-90deg) translateZ(36rpx);
  background: linear-gradient(145deg, #f5d8b2, #eac18f);
}
.dice-shadow {
  position: absolute;
  left: 13rpx;
  bottom: 0;
  width: 84rpx;
  height: 18rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(123, 74, 24, 0.28), rgba(123, 74, 24, 0) 72%);
}

.pip {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d87920;
  box-shadow: inset 0 2rpx 3rpx rgba(103, 48, 5, 0.3), 0 1rpx 0 rgba(255, 255, 255, 0.75);
  transform: translate(-50%, -50%);
}
.pip-top-left { top: 24%; left: 24%; }
.pip-top-right { top: 24%; left: 76%; }
.pip-middle-left { top: 50%; left: 24%; }
.pip-middle-right { top: 50%; left: 76%; }
.pip-center { top: 50%; left: 50%; }
.pip-bottom-left { top: 76%; left: 24%; }
.pip-bottom-right { top: 76%; left: 76%; }
.pip-one { width: 17rpx; height: 17rpx; background: #e86436; }

.dice-caption {
  margin-top: 10rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #98571f;
  font-size: 21rpx;
  line-height: 30rpx;
  text-align: center;
}
.is-pressing .dice-lift { transform: scale(0.94); }
.is-dragging .dice-lift { transform: translateY(-4rpx) scale(1.04); }
.dice-rolling {
  transition: none;
  animation-name: dice-roll;
  animation-timing-function: cubic-bezier(0.12, 0.68, 0.24, 1);
  animation-fill-mode: both;
  will-change: transform;
}
@keyframes dice-roll {
  from { transform: rotateX(-24deg) rotateY(32deg) rotateZ(-6deg); }
  /* X/Y/Z 分别转三/四/两圈，六面轮流出现，结束姿态与静止时一致。 */
  to { transform: rotateX(1056deg) rotateY(1472deg) rotateZ(714deg); }
}
.dice-tossing {
  transition: none;
  animation-name: dice-toss;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}
@keyframes dice-toss {
  0%, 100% { transform: translateY(0); }
  18% { transform: translateY(-16rpx); }
  46% { transform: translateY(-7rpx); }
  68% { transform: translateY(0); }
  82% { transform: translateY(-3rpx); }
}
.dice-shadow-rolling {
  animation-name: dice-shadow-roll;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}
@keyframes dice-shadow-roll {
  0%, 100% { transform: scale(1); opacity: 1; }
  18% { transform: scale(0.74); opacity: 0.45; }
  46% { transform: scale(0.9); opacity: 0.7; }
  68% { transform: scale(1); opacity: 1; }
  82% { transform: scale(0.95); opacity: 0.85; }
}
.hold-ring {
  position: absolute;
  top: -23rpx;
  left: -23rpx;
  width: 156rpx;
  height: 156rpx;
  z-index: 3;
  pointer-events: none;
}
.hold-ring-track {
  position: absolute;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border: 7rpx solid #ffe4c0;
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.9), 0 0 16rpx rgba(237, 139, 38, 0.2);
}
.hold-ring-half {
  position: absolute;
  top: 0;
  width: 78rpx;
  height: 156rpx;
  overflow: hidden;
}
.hold-ring-right { right: 0; }
.hold-ring-left { left: 0; }
.hold-ring-arc {
  position: absolute;
  top: 0;
  width: 156rpx;
  height: 156rpx;
  box-sizing: border-box;
  border: 7rpx solid #ed8b26;
  border-radius: 50%;
  animation-timing-function: linear;
  animation-fill-mode: both;
}
.hold-ring-right .hold-ring-arc {
  left: -78rpx;
  clip: rect(0, 78rpx, 156rpx, 0);
  animation-name: hold-ring-right;
}
.hold-ring-left .hold-ring-arc {
  left: 0;
  clip: rect(0, 156rpx, 156rpx, 78rpx);
  animation-name: hold-ring-left;
}
@keyframes hold-ring-right {
  0% { transform: rotate(0deg); }
  50%, 100% { transform: rotate(180deg); }
}
@keyframes hold-ring-left {
  0%, 50% { transform: rotate(0deg); }
  100% { transform: rotate(180deg); }
}
.hold-ring-complete .hold-ring-arc {
  animation: none;
  transform: rotate(180deg);
}
.is-pressing .dice-caption { transform: translateY(18rpx); }

.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(40, 31, 22, 0.44);
}
.dialog-panel {
  position: fixed;
  top: 50%;
  left: 24rpx;
  right: 24rpx;
  z-index: 201;
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 26rpx;
  overflow: hidden;
  transform: translateY(-50%);
  border-radius: 36rpx;
  background: #fffcf7;
  box-shadow: 0 24rpx 80rpx rgba(63, 41, 21, 0.22);
}
.settings-panel { height: 82vh; max-height: 1120rpx; }
.dialog-heading { display: flex; flex-direction: column; flex-shrink: 0; padding-bottom: 24rpx; }
.eyebrow { color: #c58646; font-size: 19rpx; letter-spacing: 3rpx; margin-bottom: 10rpx; }
.dialog-title { font-size: 37rpx; font-weight: 600; color: #423020; }
.dialog-subtitle { margin-top: 12rpx; color: #96816b; font-size: 23rpx; line-height: 1.6; }
.season-setting {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 18rpx;
  margin-bottom: 18rpx;
  border-radius: 22rpx;
  background: #fff0dc;
}
.season-description { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.season-title { font-size: 27rpx; color: #684222; }
.season-note { font-size: 20rpx; color: #a08160; margin-top: 8rpx; line-height: 1.5; }
.dialog-scroll { width: 100%; height: 0; flex: 1; min-height: 0; }
.default-hint { color: #a08160; font-size: 22rpx; line-height: 1.6; padding: 4rpx 4rpx 18rpx; }
.category-row {
  display: flex;
  align-items: center;
  padding: 18rpx 12rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #eee6dc;
  border-radius: 20rpx;
  background: #fff;
}
.category-selected { border-color: #f2c48e; background: #fff8ee; }
.category-unavailable { opacity: 0.5; background: #f4f0ea; }
.category-choice { 
  flex: 1; 
  min-width: 0; 
  display: flex; 
  align-items: center;
  /* background: red;  */
}
.category-info { 
  flex: 1; 
  min-width: 0; 
  display: flex; 
  flex-direction: column; 
  margin-left: 6rpx;
  /* background: green; */
}
.category-name { font-size: 27rpx; color: #574434; overflow-wrap: break-word; }
.category-available { font-size: 21rpx; color: #aa9580; margin-top: 6rpx; }
.quantity-control { 
  display: flex; 
  min-width: 0; 
  flex-shrink: 0; 
  align-items: center; 
  margin-left: 12rpx;
  /* background: blue;  */
}
.quantity-disabled { opacity: 0.4; }
.quantity-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50rpx;
  border-radius: 14rpx;
  background: #ffecd4;
  color: #9b601f;
  font-size: 34rpx;
  line-height: 1;
}
/* 覆盖 v2 按钮的默认尺寸；flex-basis 使用 auto，后续只需调整 width。 */
.quantity-control .quantity-button {
  width: 50rpx;
  min-width: 0;
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.quantity-button::after, .action-button::after { border: none; }
.quantity-button-disabled { background: #f3ece3; color: #bfb2a2; }
.quantity-input { width: 50rpx; height: 56rpx; margin: 0 4rpx; color: #574434; font-size: 27rpx; text-align: center; }
.quantity-unit { 
  flex-shrink: 0; 
  color: #aa9580; 
  font-size: 22rpx; 
  margin-left: 10rpx; 
}
.form-error { flex-shrink: 0; color: #bd5328; font-size: 23rpx; margin-top: 14rpx; }
.dialog-actions { display: flex; flex-shrink: 0; padding-top: 22rpx; }
.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 82rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.secondary { background: #f0e8dd; color: #8d7358; }
.primary { margin-left: 18rpx; background: linear-gradient(120deg, #f5a43e, #ed8824); color: #fff; }
.action-button.primary.action-button-disabled { background: #e7dfd4; color: #b0a18f; }
.result-row { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f0e7dc; }
.result-image { width: 112rpx; height: 112rpx; flex-shrink: 0; border-radius: 22rpx; background: #f6edde; }
.result-info { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 22rpx; }
.result-name-row { display: flex; align-items: flex-start; }
.result-name { flex: 1; min-width: 0; color: #57402d; font-size: 30rpx; font-weight: 600; overflow-wrap: break-word; }
.season-badge { flex-shrink: 0; margin-left: 12rpx; padding: 3rpx 12rpx; border-radius: 10rpx; background: #e9f4e9; color: #438453; font-size: 20rpx; }
.result-category { font-size: 23rpx; color: #b28656; margin-top: 8rpx; }
.result-season { font-size: 22rpx; color: #a39381; margin-top: 6rpx; }
.empty-state { padding: 40rpx 16rpx; text-align: center; color: #a39381; font-size: 26rpx; line-height: 1.8; }
.result-warning { padding: 16rpx 20rpx; margin-top: 14rpx; border-radius: 16rpx; background: #fff0dc; color: #a26b32; font-size: 23rpx; line-height: 1.6; }
.result-tip { flex-shrink: 0; padding-top: 20rpx; text-align: center; color: #ad9982; font-size: 22rpx; }
.scroll-end { height: 8rpx; }
