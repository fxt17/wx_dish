/*底部导航栏*/
.tab-bar{
  position:fixed;
  bottom:0;
  left:0;
  width:100%;
  height:130rpx;
  display:flex;
  background:white;
  border-top:1px solid #ddd;
  z-index:103;
}
.tab-item{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  font-size:24rpx;
}
.tab-item-icon{
  width:60rpx;
  height:60rpx;
}
.tab-item-text{
  font-size:24rpx;
  margin-top:8rpx;
}

