/* components/counter/counter.wxss */
.counter {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
/* 加减按钮 */
.counter-button-minus{
  width: 50rpx;
  height: 50rpx;

  display:flex;
  align-items:center;
  justify-content: center;
  background:#f5f5f5;
  border-radius: 50%;
  border:2rpx solid #ff8800;
}
/* 加减按钮 */
.counter-button-plus{
  width: 50rpx;
  height: 50rpx;

  display:flex;
  align-items:center;
  justify-content: center;
  background:#ffddb7;
  border-radius: 50%;
  border:2rpx solid #ff8800;
}
/* 数量 */
.counter-text {
  width: 50rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}
.counter-button-icon{
  width:40%;
  height:40%;
}